-- Find Steal Eggs
local function GetStealEggs()
    local eggs = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj.Name == "SmartPromptPart" and obj:IsA("BasePart") then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
            if prompt and prompt.ActionText == "Steal" then
                table.insert(eggs, {Part = obj, Prompt = prompt, Pos = obj.Position})
            end
        end
    end
    return eggs
end

-- Anti-Ragdoll System
local RagdollConnection = nil
local function EnableAntiRagdoll()
    if RagdollConnection then return end
    RagdollConnection = RunService.Heartbeat:Connect(function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            local state = hum:GetState()
            if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                hum.PlatformStand = false
            end
        end
    end)
end

-- Tween Function
local CurrentTween = nil
local function TweenTo(pos, speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if CurrentTween then CurrentTween:Cancel() end
    
    local dist = (pos - root.Position).Magnitude
    local time = math.max(dist / speed, 0.5)
    
    CurrentTween = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos)
    })
    CurrentTween:Play()
    return CurrentTween
end

-- Fire Prompt
local function FirePrompt(prompt)
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 50
    fireproximityprompt(prompt)
end

-- Check if holding egg
local function IsHoldingEgg()
    local char = LocalPlayer.Character
    if not char then return false end
    
    -- Check for held egg indicator
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") and gui.Text:lower():find("drop") then
            return true
        end
    end
    
    return false
end

-- Main Farm Loop
local function FarmLoop()
    while IsFarming do
        if not GetAntiCheat() then
            StatusText.Text = "⏸️ PAUSED - Anti-Cheat OFF"
            wait(1)
            continue
        end
        
        -- Get eggs
        local eggs = GetStealEggs()
        if #eggs == 0 then
            StatusText.Text = "⏳ Waiting for eggs to spawn..."
            wait(2)
            continue
        end
        
        -- Find nearest egg
        local char = LocalPlayer.Character
        if not char then wait(1) continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then wait(1) continue end
        
        local nearest = nil
        local minDist = math.huge
        
        for _, egg in ipairs(eggs) do
            local dist = (egg.Pos - root.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = egg
            end
        end
        
        if nearest then
            Attempts = Attempts + 1
            StatusText.Text = "🚀 Going to egg..."
            StatsText.Text = "Eggs Stolen: " .. EggsStolen .. "\nAttempts: " .. Attempts .. "\nCurrent Area: Stealing\nTarget Egg: " .. math.floor(nearest.Pos.X) .. ", " .. math.floor(nearest.Pos.Z)
            
            -- Tween to egg
            TweenTo(nearest.Pos + Vector3.new(0, 3, 0), 350)
            wait(1)
            
            -- Fire prompt multiple times
            StatusText.Text = "🥚 Stealing..."
            for i = 1, 5 do
                FirePrompt(nearest.Prompt)
                if Remotes.ScrambleCollect then
                    pcall(function() Remotes.ScrambleCollect:FireServer(nearest.Part) end)
                end
                wait(0.1)
            end
            
            -- Check if stolen
            wait(0.5)
            if IsHoldingEgg() then
                EggsStolen = EggsStolen + 1
                StatusText.Text = "✅ Egg stolen! Returning..."
                
                -- Return to plot
                local plotPos = SelectedPlot and SelectedPlot.Pos or Vector3.new(464, 73, -364)
                TweenTo(plotPos, 500)
                wait(2)
                
                -- Try to place egg
                if Remotes.AskFieldEggCarry then
                    pcall(function() Remotes.AskFieldEggCarry:InvokeServer() end)
                end
                
                StatusText.Text = "✅ Egg secured!"
                wait(1)
            else
                StatusText.Text = "❌ Failed to steal"
                wait(1)
            end
        end
        
        wait(0.5)
    end
    
    StatusText.Text = "⏸️ IDLE - Farming stopped"
end

